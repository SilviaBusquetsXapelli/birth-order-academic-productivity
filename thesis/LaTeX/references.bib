@article{Gobbi2024,
title = {The {C}ustomary {A}tlas of {A}ncien {R}égime {F}rance},
journal = {Explorations in Economic History},
volume = {93},
pages = {101588},
year = {2024},
issn = {0014-4983},
doi = {https://doi.org/10.1016/j.eeh.2024.101588},
url = {https://www.sciencedirect.com/science/article/pii/S001449832400024X},
author = {Victor Gay and Paula E. Gobbi and Marc Goñi},
keywords = {Customary law, Custom, Institution, Legal origin, Ancien Régime, France},
abstract = {Customary law governed most European societies during the Middle Ages and early modern period. To better understand the roots of legal customs and their implications for long-run development, we introduce an atlas of customary regions of Ancien Régime France. We also describe the historical origins of French customs, their role as a source of law, and their legal content. We then offer some insights into the research possibilities opened by this database.}
}

